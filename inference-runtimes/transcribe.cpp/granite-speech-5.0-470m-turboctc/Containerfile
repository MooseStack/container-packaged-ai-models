FROM transcribe-cpp-runtime:latest

# Copy the model assets from the external modelcar image.
USER root
COPY --from=docker.io/moosestack/granite-speech-5.0-470m-turboctc-gguf_packaged-modelcar:latest /models /models

# OpenShift assigns a random UID with GID 0.
RUN chown -R 1001:0 /models && \
    chmod -R g+rwX /models

USER 1001
ENV MODEL_NAME=granite-speech-5.0-470m-turboctc \
    MODEL_FILE=granite-speech-5.0-470m-turboctc-Q6_K.gguf
