FROM nemo-speech-runtime:latest

# Copy the model assets from the external modelcar image.
USER root
COPY --from=moosestack/parakeet-tdt-0.6b-v3-gguf_packaged-modelcar:latest /models /models

# OpenShift assigns a random UID with GID 0.
RUN chown -R 1001:0 /models && \
    chmod -R g+rwX /models

USER 1001
CMD ["--asr-model", "/models/parakeet-tdt-0.6b-v3.q8_0.gguf", "--host", "0.0.0.0", "--port", "8080"]
